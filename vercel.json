{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "data": false
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- index.html style.css vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
